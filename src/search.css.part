<style>
.search { margin-bottom: 16px; }
.search input { width: 100%; font: inherit; font-size: 15px; color: var(--fg); background: var(--paper); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
.search input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
.search .status { font-size: 12.5px; color: var(--muted); margin: 6px 2px 0; min-height: 1em; }
.search ol.results { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 2px; max-height: 60vh; overflow-y: auto; }
.search ol.results a { display: block; padding: 6px 8px; border-radius: 6px; color: var(--fg); text-decoration: none; }
.search ol.results a:hover, .search ol.results a:focus-visible { background: var(--code-bg); }
.search ol.results .t { font-weight: 600; font-size: 13.5px; display: block; }
.search ol.results .s { font-size: 12.5px; color: var(--muted); display: block; line-height: 1.45; }
mark { background: #F3D27A; color: #12282D; border-radius: 2px; padding: 0 1px; }
main mark.hit { outline: 2px solid var(--accent); }
@media (max-width: 900px) { .search ol.results { max-height: 50vh; } }
</style>
